import math

def MyProcess_update_glucose(glucose: float, 
                             glucose_growth: float, dt: float):
    my_update(glucose, glucose_growth, dt)

def MyProcess_update_calcium(calcium: float, calcium_growth: float, 
                             alpha: float, dt: float):
    calcium * (1-exp(dt)) + alpha * calcium_growth * dt

def my_update(substrate, rate, interval):
    return substrate + rate * interval

def exp(value: float):
    return math.exp(value)


